# Copy this file to .env and fill in your values

# Upstream API configuration
PROXY_UPSTREAM_BASE=https://api.openai.com
PROXY_UPSTREAM_AUTH=Bearer sk-your-openai-key-here

# Detection sensitivity (0.0 - 1.0)
PROXY_MIN_CONFIDENCE=0.7

# Feature flags
PROXY_ENABLE_PRESIDIO=true
PROXY_ENABLE_AUDIT_LOG=true
PROXY_ENABLE_STREAMING=true

# Performance
PROXY_CACHE_TTL_SECONDS=300
PROXY_MAX_REQUEST_SIZE_MB=10

# Audit endpoint protection (leave empty for dev; set a strong random string in prod)
# Access /audit/* with header: X-Audit-Key: <your-value>
PROXY_AUDIT_API_KEY=
